{
    "name": "azutoolkit/joobq",
    "description": "JoobQ worker and producer SDK for the JoobQUI SDK gateway",
    "type": "library",
    "license": "MIT",
    "keywords": ["joobq", "jobs", "queue", "workflows"],
    "homepage": "https://www.joobq.io/docs/develop/",
    "support": {
        "issues": "https://github.com/azutoolkit/joobq-sdks/issues",
